# Redis URL：普通、密码和 TLS 连接。分项配置非空时覆盖 URL。
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_URL=rediss://default:password@primary.example.cache.amazonaws.com:6379/0

# Dawn
WS_ADDR=:8851
WS_PATH=/
ADMIN_PREFIX=/admin
ALLOWED_ORIGINS=*
# ADMIN_DISK=local
# DAWN_ADMIN_PASSWORD=123456
# DAWN_ACCESS_TTL=720h
# DAWN_REFRESH_TTL=720h
# DAWN_FRONTEND_DIRECTORY=admin
# DAWN_FRONTEND_PORT=5173
# DAWN_RUNTIME_DIRECTORY=storage/framework
HORIZON_SERIAL=true
HORIZON_CONCURRENCY=4
# HORIZON_HEARTBEAT_TTL=60
# HORIZON_WORKER_TIMEOUT=60

# Cloud storage disks
FILESYSTEM_QINIU_BUCKET=
FILESYSTEM_QINIU_ENDPOINT=
FILESYSTEM_QINIU_REGION=cn-east-1
FILESYSTEM_QINIU_ACCESS_KEY=
FILESYSTEM_QINIU_SECRET_KEY=
FILESYSTEM_QINIU_PREFIX=
FILESYSTEM_QINIU_URL=
FILESYSTEM_QINIU_PATH_STYLE=false
FILESYSTEM_COS_BUCKET=
FILESYSTEM_COS_ENDPOINT=
FILESYSTEM_COS_REGION=ap-guangzhou
FILESYSTEM_COS_ACCESS_KEY=
FILESYSTEM_COS_SECRET_KEY=
FILESYSTEM_COS_PREFIX=
FILESYSTEM_COS_URL=
FILESYSTEM_COS_PATH_STYLE=false
FILESYSTEM_S3_BUCKET=
FILESYSTEM_S3_ENDPOINT=
FILESYSTEM_S3_REGION=us-east-1
FILESYSTEM_S3_ACCESS_KEY=
FILESYSTEM_S3_SECRET_KEY=
FILESYSTEM_S3_PREFIX=
FILESYSTEM_S3_URL=
FILESYSTEM_S3_PATH_STYLE=false

# 登录地理位置；由 dawn:install 下载，cron 每日更新
GEOIP_ENABLED=true
GEOIP_PATH=storage/app/geoip/GeoLite2-City.mmdb
GEOIP_URL=https://github.com/P3TERX/GeoLite.mmdb/releases/latest/download/GeoLite2-City.mmdb

# 服务监控磁盘路径；留空使用项目所在磁盘
DAWN_MONITOR_DISK_PATH=
