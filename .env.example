APP_NAME=dawn-simple
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5123

APP_TIMEZONE=UTC
APP_LOCALE=zh
APP_FALLBACK_LOCALE=en

SERVER_HOST=127.0.0.1
SERVER_PORT=5123
SERVER_TIMEOUT=15
SERVER_READ_TIMEOUT=15s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_HEADER_BYTES=1048576
SERVER_MAX_MULTIPART_MEMORY=33554432
SERVER_TRUSTED_PROXIES=
SERVER_CLIENT_IP_HEADERS=X-Forwarded-For,X-Real-IP
SERVER_ACCESS_LOG=true
SERVER_EXCEPTION_HANDLER=true

LOG_CHANNEL=stack
APP_LOGGER_LEVEL=info
APP_LOGGER_FORMATTER=line
APP_LOGGER_FILE=storage/logs/dawn.log
ERROR_LOGGER_DRIVER=daily
ERROR_LOGGER_LEVEL=warn
ERROR_LOGGER_FORMATTER=line
ERROR_LOGGER_FILE=storage/logs/error/error.log
STDERR_LOGGER_LEVEL=debug
STDERR_LOGGER_FORMATTER=line
STDOUT_LOGGER_LEVEL=debug
STDOUT_LOGGER_FORMATTER=line

DB_CONNECTION=mysql
DB_DATABASE=dawn-admin
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_CHARSET=utf8mb4
DB_TIMEZONE=
# DB_PARSE_TIME=true
# DB_LOC=Local
# DB_COLLATION=
# DB_UNIX_SOCKET=
# DB_PREFIX=
# DB_STRICT=false
# DB_MODES=
# DB_ISOLATION_LEVEL=
# DB_ENGINE=
# DB_SSL_CA=
# DB_SSL_CERT=
# DB_SSL_KEY=
# DB_SSL_INSECURE_SKIP_VERIFY=false
# DB_OPTION_TIMEOUT=
# DB_OPTION_READ_TIMEOUT=
# DB_OPTION_WRITE_TIMEOUT=
# DB_DSN=
# DB_MAX_OPEN_CONNS=30
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=1h
# DB_CONN_MAX_IDLE_TIME=10m

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_ENCODING=
SESSION_CONNECTION=default
SESSION_PREFIX=dawn-simple:local:session
SESSION_COOKIE=prismgo_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_FILES=storage/framework/sessions
SESSION_LOCK_SECONDS=10
SESSION_LOCK_WAIT_SECONDS=10

QUEUE_CONNECTION=redis
QUEUE_ENCODING=
QUEUE_FAILED_DRIVER=redis
QUEUE_FAILED_STORE=default
QUEUE_FAILED_PREFIX=dawn-simple:local:failed
QUEUE_FAILED_TTL=0
QUEUE_BATCHING_DRIVER=redis
QUEUE_BATCHING_STORE=default
QUEUE_BATCHING_PREFIX=dawn-simple:local:batches
QUEUE_BATCHING_TTL=0
QUEUE_RESTART_CACHE=
QUEUE_RESTART_KEY=dawn-simple:local:queue:restart
SYNC_QUEUE=default

# DATABASE_QUEUE=default
# DATABASE_QUEUE_TABLE=jobs

CACHE_STORE=redis
CACHE_ENCODING=
CACHE_PREFIX=dawn-simple:local
CACHE_LIMITER_DRIVER=memory
CACHE_MEMORY_PREFIX=memory
CACHE_MEMORY_TTL=0
CACHE_MEMORY_CLEANUP_INTERVAL=60
CACHE_MEMORY_EVENTS=true
CACHE_FILE_PREFIX=file
CACHE_FILE_PATH=storage/framework/cache/data
CACHE_FILE_LOCK_PATH=storage/framework/cache/locks
CACHE_FILE_TTL=0
CACHE_FILE_EVENTS=true
CACHE_FAILOVER_STORES=redis,memory
CACHE_FAILOVER_EVENTS=true
CACHE_LOCK_PREFIX=locks
CACHE_LOCK_RETRY_SLEEP_MS=50
CACHE_FLEXIBLE_REFRESH_TIMEOUT=30

PRISMGO_ENCODING=msgpack

FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=oss
FILESYSTEM_SIGNING_KEY=
FILESYSTEM_LOCAL_ROOT=storage/app/private
FILESYSTEM_LOCAL_URL=
FILESYSTEM_LOCAL_VISIBILITY=private
FILESYSTEM_LOCAL_SERVE=true
FILESYSTEM_PUBLIC_ROOT=storage/app/public
FILESYSTEM_PUBLIC_URL=http://localhost:8080/storage
FILESYSTEM_PUBLIC_VISIBILITY=public
FILESYSTEM_PUBLIC_SERVE=true

REDIS_CLIENT=go
